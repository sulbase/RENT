{
  "name": "@clawnify/open-property",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n ui,api -c cyan,green --restart-tries 3 --restart-after 1500 \"vite\" \"node scripts/dev-api.mjs\"",
    "prepare:local-auth": "node scripts/prepare-local-auth.mjs",
    "dev:auth": "node scripts/prepare-local-auth.mjs && pnpm dev",
    "db:migrate:d1": "wrangler d1 execute open-property-db --local --file=src/server/schema.sql",
    "db:pg:generate": "drizzle-kit generate",
    "db:pg:migrate": "drizzle-kit migrate",
    "build": "node scripts/build-web.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "preview:worker": "pnpm build && wrangler preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/server",
    "format": "biome format --write src/server",
    "test": "vitest run"
  },
  "dependencies": {
    "@clawnify/app": "^0.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.575.0",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
